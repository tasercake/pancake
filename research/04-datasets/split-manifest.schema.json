{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/focus-stacking/split-manifest-0.1.0.schema.json",
  "title": "Proposed focus-stacking split manifest",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "dataset_version",
    "policy_sha256",
    "scene_manifest_sha256",
    "assignment_method",
    "seed",
    "groups",
    "frozen_at",
    "exposure_audit",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "status": {
      "enum": [
        "example",
        "proposed",
        "frozen"
      ]
    },
    "dataset_version": {
      "type": "string"
    },
    "policy_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scene_manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "assignment_method": {
      "type": "string"
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "frozen_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "leakage_group_id",
          "scene_ids",
          "split_role",
          "strata"
        ],
        "properties": {
          "leakage_group_id": {
            "type": "string"
          },
          "scene_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "split_role": {
            "enum": [
              "unassigned",
              "algorithm_train",
              "algorithm_validation",
              "algorithm_test",
              "metric_development",
              "metric_qualification",
              "external_regression",
              "external_stress",
              "quarantine"
            ]
          },
          "strata": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "exposure_audit": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "frozen"
          }
        }
      },
      "then": {
        "properties": {
          "policy_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scene_manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "frozen_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
