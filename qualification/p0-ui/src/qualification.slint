import { Button } from "std-widgets.slint";

export component QualificationWindow inherits Window {
    title: "Pancake P0 native qualification";
    width: 720px;
    height: 630px;
    background: #101520;
    in-out property <image> picture;
    in-out property <string> worker-state: "Queued";
    in-out property <string> pattern-state: "Pattern A";
    in-out property <string> completed-batches: "0";
    in-out property <string> submitted-batches: "0";
    in-out property <string> ui-count: "0";
    in-out property <string> cache-peak: "0";
    in-out property <string> interop-state: "Pending";
    in-out property <string> budget-state: "";
    in-out property <string> device-state: "";
    callback toggle-pattern();
    callback start-job();
    callback cancel-job();
    callback ping-ui();
    property <bool> active: root.worker-state == "Running" || root.worker-state == "Queued";
    Text { x: 20px; y: 12px; text: "Safe Slint + CubeCL preview"; color: white; font-size: 22px; }
    Rectangle {
        x: 20px; y: 52px; width: 512px; height: 384px;
        accessible-role: image;
        accessible-id: "preview";
        accessible-label: "Computed preview";
        background: #ff00ff;
        Image { width: parent.width; height: parent.height; source: root.picture; image-fit: fill; accessible-role: none; }
    }
    HorizontalLayout {
        x: 20px; y: 448px; width: 680px; height: 36px; spacing: 8px;
        Button { text: "Toggle pattern"; accessible-id: "toggle-pattern"; enabled: !root.active; clicked => { root.toggle-pattern(); } }
        Button { text: "Start 128 batches"; accessible-id: "start-job"; enabled: !root.active; clicked => { root.start-job(); } }
        Button { text: "Cancel"; accessible-id: "cancel-job"; enabled: root.active; clicked => { root.cancel-job(); } }
        Button { text: "Ping UI"; accessible-id: "ping-ui"; clicked => { root.ping-ui(); } }
    }
    HorizontalLayout {
        x: 20px; y: 492px; width: 680px; height: 24px; spacing: 10px;
        Text { text: root.worker-state; color: white; accessible-id: "worker-state"; }
        Text { text: root.pattern-state; color: white; accessible-id: "pattern-state"; }
        Text { text: root.completed-batches; color: white; accessible-id: "completed-batches"; }
        Text { text: root.submitted-batches; color: white; accessible-id: "submitted-batches"; }
        Text { text: root.ui-count; color: white; accessible-id: "ui-count"; }
        Text { text: root.cache-peak; color: white; accessible-id: "cache-peak"; }
    }
    Text { x: 20px; y: 524px; text: root.interop-state; color: #aaccff; accessible-id: "interop-state"; }
    Text { x: 20px; y: 552px; width: 680px; height: 36px; wrap: word-wrap; text: root.budget-state; color: #aaccff; font-size: 10px; accessible-id: "budget-state"; }
    Text { x: 20px; y: 596px; text: root.device-state; color: #aaccff; font-size: 11px; accessible-id: "device-state"; }
}
