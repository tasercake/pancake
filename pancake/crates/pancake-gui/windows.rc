LANGUAGE 9, 1

1 ICON "pancake.ico"

1 VERSIONINFO
 FILEVERSION PANCAKE_VERSION
 PRODUCTVERSION PANCAKE_VERSION
 FILEOS 0x00040004L
 FILETYPE 0x00000001L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Pancake Stacker"
            VALUE "ProductName", "Pancake Stacker"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
