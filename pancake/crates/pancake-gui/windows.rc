LANGUAGE 9, 1

1 ICON "pancake.ico"

1 VERSIONINFO
 FILEVERSION PANCAKE_VERSION
 PRODUCTVERSION PANCAKE_VERSION
 FILEOS 0x00040004L
 FILETYPE 0x00000001L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Pancake Stacker\0"
            VALUE "FileVersion", PANCAKE_VERSION_TEXT
            VALUE "InternalName", "pancake-gui\0"
            VALUE "OriginalFilename", "pancake-gui.exe\0"
            VALUE "ProductName", "Pancake Stacker\0"
            VALUE "ProductVersion", PANCAKE_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
